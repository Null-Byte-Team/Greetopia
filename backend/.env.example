APP_NAME=Greetopia API
API_PREFIX=/api/v1
DATABASE_PATH=/app/storage/smart_irrigation.db
PHOTO_DIR=/app/storage/photos
MAX_PHOTO_BYTES=5000000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,capacitor://localhost
# Set true only after configuring a private authenticated broker.
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_KEEPALIVE=45
DEFAULT_PLANT_ID=plant01
DECISION_INTERVAL_MINUTES=15
IRRIGATION_COOLDOWN_MINUTES=30
# Enable only after bench-testing with the pump disconnected.
AUTO_DECISIONS_ENABLED=false
SENSOR_STALE_MINUTES=5
ROOT_MOISTURE_THRESHOLD=28
RAIN_SKIP_PROBABILITY=0.65
DEFAULT_WATER_SECONDS=5
# Optional; set only if you have a measured/calibrated flow rate.
FLOW_ML_PER_SECOND=
GEMINI_ENABLED=true
# Do not enable automatic vision until quota/cost and camera cadence are understood.
AUTO_VISION_ANALYSIS=false
# Optional shared token for camera uploads. If set, add X-Device-Token to ESP32-CAM firmware.
DEVICE_UPLOAD_TOKEN=
# Legacy/general key for camera uploads and fallback. Keep every key server-side.
GEMINI_API_KEY=
# Dedicated key for the chatbot endpoint.
GEMINI_CHAT_API_KEY=
# Optional keys used only for photo analysis requests from the respective native app.
GEMINI_ANDROID_API_KEY=
GEMINI_IOS_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PLANT_PROFILES_PATH=data/plant_profiles.json
OPENWEATHER_API_KEY=
OPENWEATHER_LAT=
OPENWEATHER_LON=
# Google OAuth & JWT Authentication
GOOGLE_CLIENT_ID=355615741600-5tfd5st7gr7ihnl81k78794u853u32qc.apps.googleusercontent.com
JWT_SECRET=


# Greetopia Environment Configuration Template
# (Do NOT commit real production credentials or private keys)

# Production backend API base URL
# Leave blank to use default (https://greetopia.vercel.app/api/v1)
VITE_API_BASE=https://greetopia.vercel.app/api/v1

# Direct APK download link (defaults to /downloads/greetopia.apk served by the frontend)
VITE_ANDROID_DOWNLOAD_URL=/downloads/greetopia.apk

# iOS IPA download link (optional)
VITE_IOS_DOWNLOAD_URL=

# Google OAuth Client ID for web sign-in
VITE_GOOGLE_CLIENT_ID=355615741600-5tfd5st7gr7ihnl81k78794u853u32qc.apps.googleusercontent.com

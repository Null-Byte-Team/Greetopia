# ---- Core ----
APP_NAME=Greetopia API
APP_ENV=development
API_PREFIX=/api/v1
DATABASE_PATH=/app/storage/smart_irrigation.db
PHOTO_DIR=/app/storage/photos
MAX_PHOTO_BYTES=5000000
# Explicit origins only (wildcards are ignored).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost

# ---- Auth (REQUIRED in production) ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=
# First registered account becomes admin; others are read-only viewers unless listed here (comma separated).
ADMIN_EMAILS=
OPERATOR_EMAILS=
# Shared secret the ESP32 nodes send as X-Device-Token (telemetry-over-HTTP and camera uploads).
DEVICE_UPLOAD_TOKEN=
# Development only. Refused when APP_ENV=production.
ALLOW_INSECURE_DEVICES=false

# ---- MQTT (use a PRIVATE broker with username/password + TLS) ----
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CA_FILE=
MQTT_QUEUE_SIZE=1000
# Public brokers (HiveMQ, Mosquitto test...) are refused unless this is true. Development only.
MQTT_DEV_PUBLIC_BROKER=false

# ---- Decision engine / safety (initial experimental defaults) ----
DECISION_INTERVAL_MINUTES=15
# Keep false until bench-tested with the pump disconnected. Decisions are still logged.
AUTO_DECISIONS_ENABLED=false
IRRIGATION_COOLDOWN_MINUTES=30
MANUAL_COOLDOWN_SECONDS=60
MAX_DAILY_RUNTIME_SECONDS=60
MAX_COMMANDS_PER_DAY=6
CONFIRM_TIMEOUT_SECONDS=45
HYSTERESIS_PCT=5
RAIN_SKIP_PROBABILITY=0.65
DECISION_MAX_AGE_S=90
READINGS_RETENTION_DAYS=90
# Optional; set only after measuring the pump with a graduated cylinder.
FLOW_ML_PER_SECOND=

# ---- Sensors freshness (derived from telemetry) ----
SENSOR_STALE_MINUTES=5
DEVICE_ONLINE_MAX_AGE_S=45
DEVICE_STALE_MAX_AGE_S=300

# ---- AI (server side only; never put these in the frontend) ----
GEMINI_ENABLED=true
AUTO_VISION_ANALYSIS=false
GEMINI_API_KEY=
GEMINI_CHAT_API_KEY=
GEMINI_ANDROID_API_KEY=
GEMINI_IOS_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_RATE_LIMIT_PER_MINUTE=10
PLANT_PROFILES_PATH=data/plant_profiles.json

# ---- Weather (optional; per-plant latitude/longitude override these) ----
OPENWEATHER_API_KEY=
OPENWEATHER_LAT=
OPENWEATHER_LON=

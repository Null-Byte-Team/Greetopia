// Copy to "secrets.h" and fill in. NEVER commit secrets.h.
#pragma once
#define WIFI_SSID        "YOUR_WIFI_NAME"      // 2.4 GHz
#define WIFI_PASSWORD    "YOUR_WIFI_PASSWORD"
// Use HTTPS in any deployment. For plain HTTP on a trusted LAN only, use http:// and set USE_TLS to 0.
#define SERVER_URL       "https://api.example.com/upload"
#define USE_TLS          1
#define PLANT_ID         "plant01"             // must match the sensor node and the backend plant id
// Must equal the backend DEVICE_UPLOAD_TOKEN. Required: the backend rejects uploads without it.
#define DEVICE_TOKEN     "CHANGE_ME"
// CA certificate that signed the server certificate (PEM). Needed when USE_TLS = 1.
static const char SERVER_CA_CERT[] = R"EOF_CA(
-----BEGIN CERTIFICATE-----
PASTE_YOUR_CA_CERTIFICATE_HERE
-----END CERTIFICATE-----
)EOF_CA";

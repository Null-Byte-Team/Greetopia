// Copy this file to "secrets.h" (same folder) and fill it in. NEVER commit secrets.h.
#pragma once

#define WIFI_SSID      "YOUR_WIFI_NAME"        // 2.4 GHz network
#define WIFI_PASSWORD  "YOUR_WIFI_PASSWORD"

// Use a PRIVATE broker (e.g. Mosquitto on your server) with a username/password and an ACL.
// Public brokers such as broker.hivemq.com let ANYONE publish "ON" to your pump.
#define MQTT_BROKER    "mqtt.example.com"
#define MQTT_PORT      8883                    // 8883 = TLS, 1883 = plain (LAN only)
#define MQTT_USER      "plant01"
#define MQTT_PASS      "CHANGE_ME"
#define USE_TLS        1                       // 1 = TLS with the CA certificate below, 0 = plain TCP

#define PLANT_ID       "plant01"               // must match the camera node and the backend plant id

// PEM of the CA that signed your broker certificate (only used when USE_TLS = 1).
static const char MQTT_CA_CERT[] = R"EOF_CA(
-----BEGIN CERTIFICATE-----
PASTE_YOUR_CA_CERTIFICATE_HERE
-----END CERTIFICATE-----
)EOF_CA";
